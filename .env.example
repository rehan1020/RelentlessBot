# ==========================================
# RelentlessBot Configuration
# GitHub: github.com/rehan1020/RelentlessBot
# ==========================================

# 1. Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=your_telegram_bot_token_here

# 2. Access Control (Whitelisting)
# Comma-separated list of Telegram User IDs allowed to use the bot.
# Get your ID from @userinfobot or @raw_data_bot on Telegram.
# Example: ALLOWED_USER_IDS=123456789,987654321
# Leave empty or set to * to allow any user (multi-user mode).
ALLOWED_USER_IDS=

# 3. Timezone
# Find your timezone string: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Asia/Kolkata

# 4. Quiet Hours (No notifications sent during this window)
# 24-hour format (HH:MM)
QUIET_HOURS_START=00:00
QUIET_HOURS_END=07:00

# 5. Morning Wake-up & Task Prompt
MORNING_PROMPT_TIME=07:05

# 6. Reminder Cadence (in minutes)
# High Priority: 30 to 60 minutes (default: 45)
HIGH_PRIORITY_INTERVAL_MINUTES=45
# Medium Priority: 1.5 to 2 hours (default: 90)
MEDIUM_PRIORITY_INTERVAL_MINUTES=90
# Low Priority: 2.5 to 3 hours (default: 150)
LOW_PRIORITY_INTERVAL_MINUTES=150

# 7. Database Path (SQLite)
DB_PATH=data/relentless.db
